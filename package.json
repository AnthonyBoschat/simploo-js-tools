{
    "name": "@simploo/js-tools",
    "version": "1.0.4",
    "description": "Fonctions utilitaires JavaScript.",
    "license": "ISC",
    "author": "Anthony Boschat",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AnthonyBoschat/simploo-js-tools.git"
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest",
        "prepublishOnly": "npm run build",
        "release:patch": "npm version patch && git push --follow-tags",
        "release:minor": "npm version minor && git push --follow-tags",
        "release:major": "npm version major && git push --follow-tags"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
